# ──────────────────────────────────────────────
# .gitignore
# ──────────────────────────────────────────────

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Terraform state (contains sensitive data)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Variable files with real secrets
terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
